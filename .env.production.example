# Copy to .env.production and fill in before `docker compose up -d --build`.

# Domain served by Caddy (automatic HTTPS). DNS A/AAAA records for DOMAIN and www.DOMAIN must point to this server.
DOMAIN=induqora.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=admin@induqora.com

# Canonical site origin used in canonical URLs, sitemaps, feeds and JSON-LD (no trailing slash)
SITE_URL=https://induqora.com

# Session signing key, at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Initial admin account, created on first start only (when the database does not exist yet)
ADMIN_EMAIL=admin@induqora.com
ADMIN_PASSWORD=

# Seed categories, authors and sample articles on first start
SEED_ON_FIRST_RUN=true

# Backups (Admin > Backup & restore). Scheduled backup interval in hours (0 disables) and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
