# Public canonical origin (no trailing slash)
SITE_URL="https://induqora.com"

# SQLite for single-server deployments. For PostgreSQL, change the provider in prisma/schema.prisma.
DATABASE_URL="file:./induqora.db"

# Long random string, e.g. `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@induqora.com"
ADMIN_PASSWORD="change-me-now"

# Directory for uploaded media (served at /media/*)
UPLOAD_DIR="./uploads"

# Directory for server-side backups
BACKUP_DIR="./backups"

# Backups (Admin > Backup & restore). Scheduled backup interval in hours (0 disables) and how many to keep.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
