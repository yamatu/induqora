{
  "name": "induqora",
  "version": "1.0.0",
  "private": true,
  "description": "Induqora — Industrial Automation & Control news and insights",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:reset": "prisma db push --force-reset && node --env-file=.env prisma/seed.mjs",
    "setup": "prisma db push && node --env-file=.env prisma/seed.mjs",
    "test:e2e": "node --env-file=.env scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
    "marked": "^15.0.12",
    "next": "^15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
